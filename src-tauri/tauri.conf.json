{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OBSIDIANA",
  "version": "0.1.0",
  "identifier": "com.obsidiana.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm vite",
    "beforeBuildCommand": "pnpm vite build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OBSIDIANA",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first Markdown knowledge workspace",
    "longDescription": "OBSIDIANA is a local-first, single-user, cross-platform Markdown knowledge workspace with linked thinking, graph view, and Git-based sync."
  }
}
