# --- OBSIDIANA environment template ---
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# OBSIDIANA itself does not require any of these to run; they are here
# only for future optional integrations (Ollama, Whisper, GitHub Pages).

# --- Local AI (deferred — out of MVP) ---
# Endpoint of a local Ollama server used for chat completions.
OLLAMA_HOST=http://127.0.0.1:11434
# Default chat model to load on first request.
OLLAMA_DEFAULT_MODEL=llama3.1:8b
# Default embedding model for vector search (post-MVP).
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Local Whisper (deferred — out of MVP) ---
# Path to a whisper.cpp binary, used for voice-note transcription.
WHISPER_CPP_BIN=/usr/local/bin/whisper
# Path to a GGML Whisper model file.
WHISPER_MODEL_PATH=/usr/local/share/whisper/ggml-base.en.bin

# --- Quartz publishing (stage 5 of MVP) ---
# GitHub Pages target: <user>.github.io or a project page.
QUARTZ_DEPLOY_TARGET=github-pages
# Personal access token for the GitHub Pages deploy repo (NEVER commit a real token).
QUARTZ_GITHUB_TOKEN=ghp_replace_me
